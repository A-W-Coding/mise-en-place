# .env.example — mise-en-place
# Copy to .env and change the password in both places. .env is git-ignored:
# never commit real credentials.

# The Postgres container (docker compose up -d db). On first start with an
# empty volume, it creates POSTGRES_DB and the test database miseenplace_test.
POSTGRES_USER=miseenplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=miseenplace_dev

# The API and Prisma. The name must end in _dev: the seed refuses anything else.
DATABASE_URL=postgresql://miseenplace:change-me@localhost:5432/miseenplace_dev

# Optional
# PORT=3000
# CORS_ORIGINS=http://localhost:5173
