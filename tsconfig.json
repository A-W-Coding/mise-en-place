{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "outDir": "dist",
    "types": ["jest", "node"]
  },
  // web/ is the client, with its own tsconfig; compiling it here would fail
  "exclude": ["node_modules", "dist", "web"]
}
